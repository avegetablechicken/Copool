{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copool",
  "version": "0.1.0",
  "identifier": "io.github.copool.rust",
  "build": {
    "frontendDist": "ui",
    "beforeBundleCommand": {
      "script": "python3 ../scripts/build_rust_widget.py",
      "cwd": "."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Copool",
        "width": 360,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "files": {
        "PlugIns/CopoolWidgetsMac.appex": "../.build/rust-widget/Release/CopoolWidgetsMac.appex"
      },
      "entitlements": "native/app.entitlements"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../resources/proxyd-prebuilt-archives": "proxyd-prebuilt-archives"
    }
  }
}
